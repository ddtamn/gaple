{
	"name": "gaple",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently --names \"VITE,PARTYKIT\" --prefix-colors \"blue,green\" \"vite dev\" \"partykit dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"partykit": "partykit",
		"partykit:dev": "partykit dev",
		"ai:self-play": "tsx scripts/self-play.ts",
		"ai:self-play:quick": "tsx scripts/self-play.ts --persona all --games 1000 --iterations 24 --max-moves 80",
		"ai:benchmark": "tsx scripts/benchmark-ai.ts",
		"ai:benchmark:quick": "tsx scripts/benchmark-ai.ts --seeds 20 --iterations 64 --max-moves 80"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.3",
		"concurrently": "^10.0.0",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.22.4",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	},
	"dependencies": {
		"better-auth": "^1.6.14",
		"better-sqlite3": "^12.10.0",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"embla-carousel-svelte": "^8.6.0",
		"gsap": "^3.15.0",
		"partykit": "^0.0.115",
		"partysocket": "^1.1.19",
		"web-haptics": "^0.0.6",
		"zod": "^4.4.3"
	}
}
